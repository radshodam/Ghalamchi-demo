# Application stage: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Public site origin (used for metadata and absolute server-side fetches)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API origin used for absolute server-side fetches.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional BFF proxy. When set, Next rewrites `/api/*` to this origin.
# Leave empty to use local Route Handlers (mock API).
API_PROXY_TARGET=
